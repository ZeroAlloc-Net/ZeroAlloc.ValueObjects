<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <PackageId>ZeroAlloc.ValueObjects</PackageId>
    <Description>Zero-allocation source-generated ValueObject equality and strongly-typed IDs (ULID, UUIDv7, Snowflake, Sequential) for hot paths. Eliminates boxing and iterator allocations from CSharpFunctionalExtensions.ValueObject.GetEqualityComponents().</Description>
    <!-- Version is injected by CI via -p:Version=; fallback for local builds -->
    <Version>0.0.0-local</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!--
      Surfaces trimmer and AOT warnings for consumers that publish with PublishAot=true. The
      library doesn't itself publish AOT, so PublishAot is left unset here.
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageReference Include="ZeroAlloc.Serialisation" Version="2.4.8" />
    <!--
      Microsoft.Extensions.Hosting.Abstractions is deliberately absent (ValueObjects#58). It was
      needed only by the hosted service backing AddSnowflakeWorkerId(Func<IServiceProvider, int>),
      and it dragged Configuration.Abstractions, Diagnostics.Abstractions,
      FileProviders.Abstractions and Options into every transitive consumer of this package. That
      one overload now lives in ZeroAlloc.ValueObjects.Hosting; the rest resolve eagerly and need
      no host. Do not reintroduce it here.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    build/ makes ZeroAllocGeneratedAccessibility CompilerVisible for a project that references this
    package directly. buildTransitive/ does the same for a project that only gets it transitively,
    through a project reference to another project that references this package; the bundled
    generator runs for those consumers too.
  -->
  <ItemGroup>
    <None Remove="build\ZeroAlloc.ValueObjects.props" />
    <None Remove="buildTransitive\ZeroAlloc.ValueObjects.props" />
    <None Include="$(MSBuildThisFileDirectory)build\ZeroAlloc.ValueObjects.props"
          Pack="true"
          PackagePath="build/ZeroAlloc.ValueObjects.props" />
    <None Include="$(MSBuildThisFileDirectory)buildTransitive\ZeroAlloc.ValueObjects.props"
          Pack="true"
          PackagePath="buildTransitive/ZeroAlloc.ValueObjects.props" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.ValueObjects.Generator\ZeroAlloc.ValueObjects.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Bundle the generator DLL the build actually produced into the analyzers folder of the NuGet
    package. Asking the generator project for its target path, instead of hardcoding
    bin\$(Configuration)\netstandard2.0, follows any output redirection such as artifacts-path.
    The hardcoded path silently bundled whatever stale DLL sat in the repository's bin folder,
    at whatever version that DLL had been built with. GetTargetPath only reports the path; it
    does not build the generator, so a no-build pack stays no-build. See ZeroAlloc-Net/.github#43.
  -->
  <Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\ZeroAlloc.ValueObjects.Generator\ZeroAlloc.ValueObjects.Generator.csproj"
             Targets="GetTargetPath"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_ZeroAllocValueObjectsGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_ZeroAllocValueObjectsGeneratorAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
