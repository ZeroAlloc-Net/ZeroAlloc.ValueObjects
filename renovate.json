{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>ZeroAlloc-Net/.github"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Ignore internal ZeroAlloc packages — managed by release-please",
      "matchPackagePrefixes": ["ZeroAlloc."],
      "enabled": false
    },
    {
      "description": "Group Roslyn analyzer packages",
      "matchPackageNames": [
        "Meziantou.Analyzer",
        "Roslynator.Analyzers"
      ],
      "groupName": "Roslyn analyzers"
    },
    {
      "description": "Group xunit packages",
      "matchPackagePrefixes": ["xunit"],
      "groupName": "xunit"
    },
    {
      "description": "Group Microsoft.Extensions packages",
      "matchPackagePrefixes": ["Microsoft.Extensions."],
      "groupName": "Microsoft.Extensions"
    },
    {
      "description": "Group Microsoft.CodeAnalysis packages",
      "matchPackagePrefixes": ["Microsoft.CodeAnalysis."],
      "groupName": "Microsoft.CodeAnalysis"
    },
    {
      "description": "The generator runs in the consumer's compiler, which must be at least the Roslyn it references. Hold it at 5.0, what the oldest supported SDK band 10.0.1xx ships; raise it only with the supported SDK floor. The sdk10-consumer CI job checks this.",
      "matchFileNames": ["src/ZeroAlloc.ValueObjects.Generator/ZeroAlloc.ValueObjects.Generator.csproj"],
      "matchPackageNames": ["Microsoft.CodeAnalysis.CSharp", "Microsoft.CodeAnalysis.Common"],
      "allowedVersions": "<5.1"
    },
    {
      "description": "Group GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
