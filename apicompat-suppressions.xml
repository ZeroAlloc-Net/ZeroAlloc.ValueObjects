<!-- https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids -->
<!--
  Intentional break, accepted for the 2.0.0 major bump (ValueObjects#58).

  AddSnowflakeWorkerId(IServiceCollection, Func<IServiceProvider, int>) moved to the new
  ZeroAlloc.ValueObjects.Hosting package. It was the only overload that could not resolve its
  worker id before the container was built, so it kept the IHostedService — and that hosted
  service was the sole reason the core package depended on
  Microsoft.Extensions.Hosting.Abstractions, which reached every transitive consumer.

  Three entries, one per target framework leg, all naming that single member. Nothing else in
  the surface changed, so any other CP0002 is a genuine regression and will still fail the gate.

  REMOVE THIS FILE once 2.0.0 is published. api-compat baselines against the highest stable
  release, so from then on the member is absent from the baseline too and these suppressions
  become inert.
-->

<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:ZeroAlloc.ValueObjects.SnowflakeServiceCollectionExtensions.AddSnowflakeWorkerId(Microsoft.Extensions.DependencyInjection.IServiceCollection,System.Func{System.IServiceProvider,System.Int32})</Target>
    <Left>lib/net8.0/ZeroAlloc.ValueObjects.dll</Left>
    <Right>lib/net8.0/ZeroAlloc.ValueObjects.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:ZeroAlloc.ValueObjects.SnowflakeServiceCollectionExtensions.AddSnowflakeWorkerId(Microsoft.Extensions.DependencyInjection.IServiceCollection,System.Func{System.IServiceProvider,System.Int32})</Target>
    <Left>lib/netstandard2.0/ZeroAlloc.ValueObjects.dll</Left>
    <Right>lib/netstandard2.0/ZeroAlloc.ValueObjects.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:ZeroAlloc.ValueObjects.SnowflakeServiceCollectionExtensions.AddSnowflakeWorkerId(Microsoft.Extensions.DependencyInjection.IServiceCollection,System.Func{System.IServiceProvider,System.Int32})</Target>
    <Left>lib/netstandard2.1/ZeroAlloc.ValueObjects.dll</Left>
    <Right>lib/netstandard2.1/ZeroAlloc.ValueObjects.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
</Suppressions>